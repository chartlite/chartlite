{
  "name": "@chartlite/core",
  "version": "1.0.0",
  "description": "Core charting library - framework agnostic",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interactive": {
      "types": "./dist/interactive/index.d.ts",
      "import": "./dist/interactive/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsup",
    "size": "node scripts/check-bundle-size.mjs",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/benchmark-with-sampling.ts",
    "perf": "tsx scripts/benchmark-with-sampling.ts",
    "perf:sampling": "tsx scripts/benchmark-with-sampling.ts",
    "audit:colors": "tsx scripts/audit-colors.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "charts",
    "graphs",
    "svg",
    "visualization",
    "lightweight",
    "performance"
  ],
  "author": "Riel St. Amand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chartlite/chartlite.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chartlite/chartlite/issues"
  },
  "homepage": "https://github.com/chartlite/chartlite#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^25.0.1",
    "terser": "^5.43.1",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
